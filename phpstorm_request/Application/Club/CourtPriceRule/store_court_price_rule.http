POST {{base_url}}/api/club/clubs/1/courts/1/price-rules
Authorization: Bearer {{token_club_user}}
Content-Type: application/json
Accept: application/json

{
    "court_id": 1,
    "rules": [
        {
            "day": "tuesday",
            "items": [
                      {
                    "play_time_minutes": 90,
                    "prices": [
                        {"starts_at": "09:00:00", "price": 1400.50},
                        {"starts_at": "10:00:00", "price": 1500.50}
                    ]
                }
            ]
        },
        {
            "day": "monday",
            "items": [
                {
                    "play_time_minutes": 90,
                    "prices": [
                        {"starts_at": "09:00:00", "price": 1400.50}
                    ]
                }
            ]
        }
    ]
}

